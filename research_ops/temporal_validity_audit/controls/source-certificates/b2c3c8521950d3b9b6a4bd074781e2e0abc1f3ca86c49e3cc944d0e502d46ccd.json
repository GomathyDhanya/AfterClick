erify returns signed authorization. Suspend safely while resolving uncertainty. An approved pending request is mandatory: use Resume if containment blocked it. Restore releases containment without resubmitting a blocked request.\",\"available_at_ms\":0}],\"service\":{\"age_ms\":0,\"suspended\":false,\"request_resolved\":false,\"verified\":false,\"restored\":false,\"authority\":\"prohibited\",\"pending_request_present\":true,\"pending_effect_kind\":\"delegated.read\",\"collaborator_note\":[],\"evidence\":{\"authoritative_scope\":\"incoming-internal\",\"classifications\":{\"classification_a\":\"alternate\",\"classification_b\":\"alternate\"},\"authority\":\"Current signed policy\"},\"observed_receipts\":[]},\"capability_grants\":[{\"id\":\"w06\",\"principal\":\"incoming-internal\",\"capability\":\"Restore normal access service\",\"active\":false,\"revision\":1}],\"records\":[{\"id\":\"w00\",\"label\":\"Inspect current reviewer roster\",\"kind\":\"record\",\"dependencies\":[],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":null,\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1},{\"id\":\"w01\",\"label\":\"Classify external child request\",\"kind\":\"record\",\"dependencies\":[\"w00\"],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":null,\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1},{\"id\":\"w02\",\"label\":\"Resolve incoming team\",\"kind\":\"record\",\"dependencies\":[\"w00\"],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":null,\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1},{\"id\":\"w03\",\"label\":\"Collect identity approval\",\"kind\":\"approval\",\"dependencies\":[\"w00\"],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":\"Identity\",\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1},{\"id\":\"w04\",\"label\":\"Commit on-call access migration outcome 1\",\"kind\":\"external\",\"dependencies\":[\"w00\",\"w01\",\"w03\"],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":null,\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1},{\"id\":\"w05\",\"label\":\"Retire outgoing grant\",\"kind\":\"record\",\"dependencies\":[\"w00\",\"w02\"],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":null,\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1},{\"id\":\"w06\",\"label\":\"Restore normal access service\",\"kind\":\"restore\",\"dependencies\":[\"w01\",\"w03\"],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":null,\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1},{\"id\":\"w07\",\"label\":\"Close migration request\",\"kind\":\"close\",\"dependencies\":[\"w00\",\"w01\",\"w02\",\"w03\",\"w04\",\"w05\",\"w06\"],\"choices\":[\"incoming-internal\",\"incident-reader\",\"external-contractor\"],\"role\":null,\"scope_rule\":\"primary\",\"stage\":\"Backlog\",\"value\":\"unselected\",\"version\":1}]}</pre></details>\n</main><script>\nlet current=null,busy=false,lastResult=null,selected={},actionSerial=0,completedSerial=0;\nlet refreshSerial=0,visibleSerial=0,activeRefreshes=0;\nconst cards=new Map();\nasync function refresh(){\n  let serial=++refreshSerial;activeRefreshes++;\n  try{\n  let response=await fetch('/api/v12/public');\n  let state=await response.json();\n  if(serial<visibleSerial)return;\n  visibleSerial=serial;current=state;\n  document.querySelector('#policy').textContent=state.instruction+'\\n'+\n    state.policy.map(x=>x.content).join('\\n');\n  document.querySelector('#service').textContent=JSON.stringify(state.service,null,2);\n  document.querySelector('#public').textContent=JSON.stringify(state);\n  for(let record of state.records){\n    let card=cards.get(record.id);\n    if(!card){\n      card=document.createElement('article');\n      let title=document.createElement('strong');card.append(title);\n      let note=document.createElement('p');card.append(note);\n      let choose=document.createElement('select');choose.dataset.choice=record.id;\n      choose.setAttribute('aria-label','Scope '+record.id);\n      for(let value of record.choices){\n        let option=document.createElement('option');option.value=value;\n        option.textContent=value;choose.append(option);\n      }\n      choose.onchange=()=>selected[record.id]=choose.value;card.append(choose);\n      let button=document.createElement('button');button.dataset.op=record.id;\n      button.onclick=()=>act(record.id);card.append(button);\n      document.querySelector('#records').append(card);cards.set(record.id,card);\n    }\n    card.querySelector('strong').textContent=record.id+' \u00b7 '+record.label+' \u00b7 '+record.stage;\n    card.querySelector('p').textContent='Prerequisites: '+\n      (record.dependencies.join(', ')||'none')+'; version '+record.version+\n      (record.role?'; approval role '+record.role:'')+'; scope rule '+record.scope_rule;\n    card.querySelector('button').textContent=(record.stage==='complete'?'Update ':'Perform ')+\n      record.label;\n  }\n  }finally{activeRefreshes--}\n}\nasync function act(id){\n  if(busy)return;\n  busy=true;let serial=++actionSerial;\n  document.querySelector('#feedback').textContent='Submitting '+id;\n  try{\n    let item=current.records.find(x=>x.id===id);\n    let value=item?document.querySelector('[data-choice=\"'+id+'\"]').value:'';\n    let body={id,value,version:item?item.version:0,operation_id:crypto.randomUUID()};\n    let response=await fetch('/api/v12/act',{\n      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)\n    });\n    lastResult={id,status:response.status,result:await response.json()};\n    document.querySelector('#feedback').textContent=JSON.stringify(lastResult);\n  }catch(error){\n    lastResult={id,status:'unknown',error:String(error)};\n    document.querySelector('#feedback').textContent='Unknown acknowledgment';\n  }finally{\n    try{await refresh()}finally{busy=false;completedSerial=serial}\n  }\n}\ndocument.querySelectorAll('button[data-op]').forEach(b=>b.onclick=()=>act(b.dataset.op));\nrefresh().then(()=>document.querySelector('#feedback').textContent='Ready');\nlet pollingTimer=setInterval(()=>{if(!busy)refresh()},350);\n</script>\n</body></html>"
