{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AfterClick v12 independently verifiable task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "split",
    "application",
    "family",
    "complexity",
    "contract_version",
    "public",
    "private",
    "reference_plan",
    "authoring_status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ]
    },
    "application": {
      "enum": [
        "flowboard",
        "opsconsole"
      ]
    },
    "family": {
      "enum": [
        "customer_release",
        "access_migration",
        "incident_response",
        "resource_orchestration",
        "retention_export",
        "cross_team_approval"
      ]
    },
    "complexity": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "authoring_status": {
      "enum": [
        "design_example",
        "draft",
        "validated",
        "frozen"
      ]
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction",
        "policy_documents",
        "observation_surfaces",
        "allowed_actor_tools"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 10
        },
        "policy_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "doc_id",
              "content"
            ],
            "properties": {
              "doc_id": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "available_at_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "observation_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "allowed_actor_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "initial_public_state": {
          "type": "object"
        }
      }
    },
    "private": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_private_state",
        "obligations",
        "forbidden_histories",
        "external_schedule_law",
        "task_oracle",
        "effect_oracle",
        "allowed_controller_actions"
      ],
      "properties": {
        "initial_private_state": {
          "type": "object"
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "obligation_id",
              "predicate",
              "dependencies"
            ],
            "properties": {
              "obligation_id": {
                "type": "string"
              },
              "predicate": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requires_before_effect": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "forbidden_histories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_controller_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_schedule_law": {
          "type": "object"
        },
        "task_oracle": {
          "type": "string"
        },
        "effect_oracle": {
          "type": "string"
        },
        "oracle_impl_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "proof_scope": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reference_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_type",
        "steps",
        "verified"
      ],
      "properties": {
        "plan_type": {
          "enum": [
            "scripted_witness",
            "human_verified",
            "formal_witness",
            "none_not_yet"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "boolean"
        },
        "certificate_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "structure_metrics": {
      "type": "object",
      "properties": {
        "dependency_depth": {
          "type": "integer",
          "minimum": 0
        },
        "branching_choices": {
          "type": "integer",
          "minimum": 0
        },
        "external_effect_processes": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_required_observations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "fixture_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
